# Copy this file to .env and fill in your key. Never commit .env.
# Create the key at https://app.gnani.ai/voice/api-keys  (Add API Key).
# This one key covers both Prisma STT and Timbre TTS.
GNANI_API_KEY=PASTE_YOUR_GNANI_API_KEY_HERE

# ── Evon (optional, future-ready) ─────────────────────────────────────────
# Evon v3.3 is Gnani's own 30B reasoning model. It is not on the public
# API platform as of 10 Nov 2026 — it is open-weight on Hugging Face and
# available via private endpoint only.
#
# If Gnani grants you a private Evon endpoint, uncomment these two lines
# and the Evon backend will take over automatically (no other change needed).
#
# EVON_API_URL=https://<your-evon-endpoint>
# EVON_MODEL=evon-v3.3
